# ==============================================================================
# Typing Typhon Frontend Environment Configuration
# ==============================================================================
# Domain Independence Rule:
# The production domain is UNDECIDED. Never commit production domains or secrets.
# Use NEXT_PUBLIC_SITE_URL to configure the canonical public-facing URL.
# ==============================================================================

# Public Site Base URL (Used for Canonical URLs, Open Graph, Sitemap & Robots)
# Development Default: http://localhost:3000
# Production Example: https://typingtyphon-preview.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend NestJS API Endpoint
# Development Default: http://localhost:4001
# Production Example: https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:4001

# Search Engine Indexing Protection
# Set to 'true' in staging, QA, preview environments, or testing deployments to
# block search engine crawlers via robots.txt and noindex headers.
# Production Default: false
NEXT_PUBLIC_BLOCK_SEARCH_INDEXING=false
